{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/drinkflow-kds",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/drinkflow",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/setup",
      "destination": "/#demo",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://goldieskds.com/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
